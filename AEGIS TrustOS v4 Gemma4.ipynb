   "source": [
    "# ============================================================\n",
    "# CELL 6 :: CALIBRATION ANALYSIS — ECE & RELIABILITY DIAGRAM\n",
    "# ============================================================\n",
    "import plotly.graph_objects as go\n",
    "from plotly.subplots import make_subplots\n",
    "\n",
    "# ── Simulate calibration dataset (replace with real outputs) ──\n",
    "np.random.seed(42)\n",
    "n_samples = 500\n",
    "\n",
    "raw_logits   = np.random.randn(n_samples)\n",
    "true_labels  = (raw_logits + np.random.randn(n_samples) * 0.5 > 0).astype(int)\n",
    "\n",
    "raw_confs     = 1 / (1 + np.exp(-raw_logits))\n",
    "calib_confs   = aegis.beta_scaling(raw_logits)\n",
    "\n",
    "ece_raw   = aegis.compute_ece(raw_confs, true_labels)\n",
    "ece_calib = aegis.compute_ece(calib_confs, true_labels)\n",
    "\n",
    "print(f'📐 ECE Before Calibration : {ece_raw:.4f}')\n",
    "print(f'📐 ECE After  Calibration : {ece_calib:.4f}')\n",
    "print(f'📐 Improvement            : {(ece_raw - ece_calib)/ece_raw*100:.1f}%')\n",
    "\n",
    "# ── Reliability diagram ───────────────────────────────────────\n",
    "def reliability_data(confs, labels, n_bins=10):\n",
    "    bins = np.linspace(0, 1, n_bins + 1)\n",
    "    xs, ys = [], []\n",
    "    for lo, hi in zip(bins[:-1], bins[1:]):\n",
    "        mask = (confs > lo) & (confs <= hi)\n",
    "        if mask.sum() > 0:\n",
    "            xs.append(confs[mask].mean())\n",
    "            ys.append(labels[mask].mean())\n",
    "    return xs, ys\n",
    "\n",
    "rx, ry = reliability_data(raw_confs, true_labels)\n",
    "cx, cy = reliability_data(calib_confs, true_labels)\n",
    "\n",
    "fig = make_subplots(\n",
    "    rows=1, cols=2,\n",
    "    subplot_titles=[\n",
    "        f'Before Beta-Scaling (ECE={ece_raw:.4f})',\n",
    "        f'After Beta-Scaling  (ECE={ece_calib:.4f})',\n",
    "    ]\n",
    ")\n",
    "\n",
    "perfect = go.Scatter(x=[0,1], y=[0,1], mode='lines',\n",
    "                     line=dict(dash='dash', color='#7ee787'), name='Perfect')\n",
    "\n",
    "fig.add_trace(perfect, row=1, col=1)\n",
    "fig.add_trace(go.Scatter(x=rx, y=ry, mode='lines+markers',\n",
    "                         line=dict(color='#ff6b6b', width=2),\n",
    "                         marker=dict(size=8), name='Raw'), row=1, col=1)\n",
    "\n",
    "fig.add_trace(go.Scatter(x=[0,1], y=[0,1], mode='lines',\n",
    "                         line=dict(dash='dash', color='#7ee787'), showlegend=False), row=1, col=2)\n",
    "fig.add_trace(go.Scatter(x=cx, y=cy, mode='lines+markers',\n",
    "                         line=dict(color='#58a6ff', width=2),\n",
    "                         marker=dict(size=8), name='Calibrated'), row=1, col=2)\n",
    "\n",
    "fig.update_layout(\n",
    "    title='⬢ AEGIS-∞ Beta-Scaling Calibration — Reliability Diagrams',\n",
    "    template='plotly_dark',\n",
    "    paper_bgcolor='#0d1117',\n",
    "    plot_bgcolor='#161b22',\n",
    "    font=dict(color='#e6edf3', family='monospace'),\n",
    "    height=450,\n",
    ")\n",
    "fig.update_xaxes(title_text='Mean Confidence', range=[0,1])\n",
    "fig.update_yaxes(title_text='Fraction Positive', range=[0,1])\n",
    "fig.show()"
   ]
  },
