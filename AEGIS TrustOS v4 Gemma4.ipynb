    "# ============================================================\n",
    "# CELL 1 :: SYSTEM SETUP & DEPENDENCY CHECK\n",
    "# ============================================================\n",
    "import subprocess, sys, os\n",
    "\n",
    "def install(pkg):\n",
    "    subprocess.check_call([sys.executable, '-m', 'pip', 'install', '-q', pkg])\n",
    "\n",
    "# Core dependencies (most pre-installed on Kaggle)\n",
    "try:\n",
    "    import transformers\n",
    "    print(f'✅ transformers {transformers.__version__}')\n",
    "except ImportError:\n",
    "    install('transformers>=4.40.0')\n",
    "\n",
    "try:\n",
    "    import bitsandbytes\n",
    "    print(f'✅ bitsandbytes {bitsandbytes.__version__}')\n",
    "except ImportError:\n",
    "    install('bitsandbytes')\n",
    "\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "import torch\n",
    "import json, time, warnings\n",
    "from pathlib import Path\n",
    "from IPython.display import display, Markdown, HTML\n",
    "\n",
    "warnings.filterwarnings('ignore')\n",
    "\n",
    "# ── GPU Info ──────────────────────────────────────────────────\n",
    "if torch.cuda.is_available():\n",
    "    gpu = torch.cuda.get_device_name(0)\n",
    "    vram = torch.cuda.get_device_properties(0).total_memory / 1e9\n",
    "    print(f'\\n🖥️  GPU: {gpu}  |  VRAM: {vram:.1f} GB')\n",
    "else:\n",
    "    print('⚠️  No GPU detected — running on CPU (slower)')\n",
    "\n",
    "display(Markdown('> **⬢ AEGIS-∞ TrustOS v4.0 — Environment Ready**'))"
   ]
