    "# ============================================================\n",
    "# CELL 3 :: AEGIS CORE ENGINE — MAQASID INTERCEPTOR v4.0\n",
    "# ============================================================\n",
    "\n",
    "class AegisTrustEngine:\n",
    "    \"\"\"\n",
    "    AEGIS-∞ TrustOS v4.0\n",
    "    ─────────────────────\n",
    "    Sovereign ethical operating system aligned with Maqasid Al-Shariah.\n",
    "    Wraps any LLM (here: Gemma 4) with a 5-pillar governance layer.\n",
    "    \"\"\"\n",
    "\n",
    "    VERSION = '4.0.0'\n",
    "    AUTHOR  = 'Dr. Amin Mahmoud Ali Fayed'\n",
    "\n",
    "    PILLARS = {\n",
    "        'Life'     : {'ar': 'حفظ النفس',  'en': 'Preserve Life — block physical/medical harm',      'weight': 1.0},\n",
    "        'Intellect': {'ar': 'حفظ العقل',  'en': 'Preserve Intellect — counter misinformation',      'weight': 0.95},\n",
    "        'Faith'    : {'ar': 'حفظ الدين',  'en': 'Preserve Faith — respect cultural sovereignty',    'weight': 0.90},\n",
    "        'Lineage'  : {'ar': 'حفظ النسل',  'en': 'Preserve Lineage — protect digital privacy',       'weight': 0.85},\n",
    "        'Property' : {'ar': 'حفظ المال',  'en': 'Preserve Property — prevent exploitation/riba',    'weight': 0.80},\n",
    "    }\n",
    "\n",
    "    # ── Prohibited pattern registry ──────────────────────────\n",
    "    RISK_PATTERNS = {\n",
    "        'Life'     : ['kill', 'harm', 'suicide', 'overdose', 'poison', 'weapon', 'أذى', 'انتحار'],\n",
    "        'Intellect': ['fake', 'lie', 'misinform', 'hallucinate', 'fabricat', 'كذب', 'تضليل'],\n",
    "        'Faith'    : ['blasphemy', 'mock', 'insult religion', 'ازدراء', 'إهانة'],\n",
    "        'Lineage'  : ['dox', 'expose private', 'leak', 'identity theft', 'بيانات شخصية'],\n",
    "        'Property' : ['riba', 'usury', 'scam', 'fraud', 'exploit', 'ربا', 'احتيال'],\n",
    "    }\n",
    "\n",
    "    def __init__(self, confidence_threshold: float = 0.75):\n",
    "        self.threshold = confidence_threshold\n",
    "        self.audit_log: list = []\n",
    "        print(f'⬢ AEGIS-∞ TrustOS v{self.VERSION} initialised')\n",
    "        print(f'  Confidence threshold : {self.threshold}')\n",
    "        print(f'  Active pillars       : {len(self.PILLARS)}')\n",
    "\n",
    "    # ── Pillar scan ───────────────────────────────────────────\n",
    "    def _scan_pillars(self, text: str) -> dict:\n",
    "        text_lower = text.lower()\n",
    "        violations = {}\n",
    "        for pillar, patterns in self.RISK_PATTERNS.items():\n",
    "            hits = [p for p in patterns if p in text_lower]\n",
    "            if hits:\n",
    "                violations[pillar] = hits\n",
    "        return violations\n",
    "\n",
    "    # ── Beta-Scaling confidence calibration ──────────────────\n",
    "    def beta_scaling(self, logits: np.ndarray,\n",
    "                     alpha: float = 1.1,\n",
    "                     beta_shift: float = 0.05) -> np.ndarray:\n",
    "        \"\"\"Isotonic beta-scaling → converts raw logits to calibrated probabilities.\"\"\"\n",
    "        return 1 / (1 + np.exp(-(alpha * logits + beta_shift)))\n",
    "\n",
    "    # ── ECE (Expected Calibration Error) ─────────────────────\n",
    "    def compute_ece(self, confidences: np.ndarray,\n",
    "                    accuracies: np.ndarray,\n",
    "                    n_bins: int = 10) -> float:\n",
    "        \"\"\"Compute ECE — lower is better (0 = perfectly calibrated).\"\"\"\n",
    "        bin_boundaries = np.linspace(0, 1, n_bins + 1)\n",
    "        ece = 0.0\n",
    "        n = len(confidences)\n",
    "        for lo, hi in zip(bin_boundaries[:-1], bin_boundaries[1:]):\n",
    "            mask = (confidences > lo) & (confidences <= hi)\n",
    "            if mask.sum() == 0:\n",
    "                continue\n",
    "            acc_bin  = accuracies[mask].mean()\n",
    "            conf_bin = confidences[mask].mean()\n",
    "            ece += (mask.sum() / n) * abs(acc_bin - conf_bin)\n",
    "        return float(ece)\n",
    "\n",
    "    # ── Main interceptor ─────────────────────────────────────\n",
    "    def intercept(self, output_text: str,\n",
    "                  confidence: float,\n",
    "                  context: str = '') -> dict:\n",
    "        \"\"\"\n",
    "        Run full Maqasid governance pipeline.\n",
    "        Returns a structured verdict dict.\n",
    "        \"\"\"\n",
    "        violations = self._scan_pillars(output_text + ' ' + context)\n",
    "        low_conf   = confidence < self.threshold\n",
    "\n",
    "        if violations:\n",
    "            pillars_hit  = list(violations.keys())\n",
    "            pillar_weight = max(self.PILLARS[p]['weight'] for p in pillars_hit)\n",
    "            status  = 'INTERCEPTED'\n",
    "            icon    = '🔴'\n",
    "            message = (f\"Ethical violation detected in pillar(s): {', '.join(pillars_hit)}. \"\n",
    "                       f\"Output blocked (severity={pillar_weight:.2f}).\")\n",
    "        elif low_conf:\n",
    "            status  = 'UNCERTAIN'\n",
    "            icon    = '🟡'\n",
    "            message = (f\"Low confidence ({confidence*100:.1f}% < threshold {self.threshold*100:.0f}%). \"\n",
    "                       f\"Output flagged for human review.\")\n",
    "        else:\n",
    "            status  = 'AUTHORIZED'\n",
    "            icon    = '🟢'\n",
    "            message = f\"Output authorised. Confidence={confidence*100:.1f}%.\"\n",
    "\n",
    "        verdict = {\n",
    "            'status'     : status,\n",
    "            'icon'       : icon,\n",
    "            'confidence' : round(confidence, 4),\n",
    "            'violations' : violations,\n",
    "            'message'    : message,\n",
    "            'timestamp'  : time.strftime('%Y-%m-%dT%H:%M:%SZ', time.gmtime()),\n",
    "        }\n",
    "        self.audit_log.append(verdict)\n",
    "        return verdict\n",
    "\n",
    "    def audit_summary(self) -> pd.DataFrame:\n",
    "        \"\"\"Return audit log as a DataFrame.\"\"\"\n",
    "        if not self.audit_log:\n",
    "            return pd.DataFrame()\n",
    "        return pd.DataFrame([\n",
    "            {'timestamp': e['timestamp'], 'status': e['status'],\n",
    "             'confidence': e['confidence'], 'violations': str(e['violations'])}\n",
    "            for e in self.audit_log\n",
    "        ])\n",
    "\n",
    "\n",
    "# Instantiate global engine\n",
    "aegis = AegisTrustEngine(confidence_threshold=0.75)"
   ]
  },
