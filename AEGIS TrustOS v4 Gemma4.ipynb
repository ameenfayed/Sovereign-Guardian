    "# ============================================================\n",
    "# CELL 4 :: GEMMA 4 INFERENCE WRAPPER WITH AEGIS GOVERNANCE\n",
    "# ============================================================\n",
    "import torch.nn.functional as F\n",
    "\n",
    "def gemma_generate(\n",
    "    prompt: str,\n",
    "    system_prompt: str = None,\n",
    "    max_new_tokens: int = 256,\n",
    "    temperature: float = 0.7,\n",
    "    top_p: float = 0.9,\n",
    "    do_sample: bool = True,\n",
    ") -> dict:\n",
    "    \"\"\"\n",
    "    Generate text with Gemma 4 and apply AEGIS governance.\n",
    "    Returns full verdict + generated text.\n",
    "    \"\"\"\n",
    "    # ── Build chat prompt ─────────────────────────────────────\n",
    "    if system_prompt is None:\n",
    "        system_prompt = (\n",
    "            'You are AEGIS-∞, a sovereign ethical AI assistant guided by Maqasid Al-Shariah. '\n",
    "            'You preserve life, intellect, faith, lineage, and property in every response. '\n",
    "            'Be helpful, accurate, and culturally respectful.'\n",
    "        )\n",
    "\n",
    "    # Gemma 2/4 chat template\n",
    "    messages = [\n",
    "        {'role': 'user', 'content': f'{system_prompt}\\n\\n{prompt}'}\n",
    "    ]\n",
    "\n",
    "    try:\n",
    "        # Prefer apply_chat_template if available\n",
    "        input_text = tokenizer.apply_chat_template(\n",
    "            messages, tokenize=False, add_generation_prompt=True\n",
    "        )\n",
    "    except Exception:\n",
    "        input_text = f\"<start_of_turn>user\\n{system_prompt}\\n\\n{prompt}<end_of_turn>\\n<start_of_turn>model\\n\"\n",
    "\n",
    "    inputs = tokenizer(input_text, return_tensors='pt').to(model.device)\n",
    "\n",
    "    # ── Generate ──────────────────────────────────────────────\n",
    "    with torch.no_grad():\n",
    "        output = model.generate(\n",
    "            **inputs,\n",
    "            max_new_tokens=max_new_tokens,\n",
    "            temperature=temperature,\n",
    "            top_p=top_p,\n",
    "            do_sample=do_sample,\n",
    "            pad_token_id=tokenizer.eos_token_id,\n",
    "            return_dict_in_generate=True,\n",
    "            output_scores=True,\n",
    "        )\n",
    "\n",
    "    # ── Decode ────────────────────────────────────────────────\n",
    "    gen_ids   = output.sequences[0][inputs['input_ids'].shape[1]:]\n",
    "    gen_text  = tokenizer.decode(gen_ids, skip_special_tokens=True).strip()\n",
    "\n",
    "    # ── Confidence estimation from token probabilities ────────\n",
    "    if output.scores:\n",
    "        token_probs = []\n",
    "        for score in output.scores:\n",
    "            probs = F.softmax(score[0], dim=-1)\n",
    "            token_probs.append(probs.max().item())\n",
    "        confidence = float(np.mean(token_probs))\n",
    "    else:\n",
    "        confidence = 0.80  # Fallback\n",
    "\n",
    "    # ── Apply Beta-Scaling calibration ───────────────────────\n",
    "    raw_logit   = np.log(confidence / (1 - confidence + 1e-9))\n",
    "    calibrated  = aegis.beta_scaling(np.array([raw_logit]))[0]\n",
    "\n",
    "    # ── AEGIS Governance ─────────────────────────────────────\n",
    "    verdict = aegis.intercept(\n",
    "        output_text=gen_text,\n",
    "        confidence=calibrated,\n",
    "        context=prompt,\n",
    "    )\n",
    "\n",
    "    return {\n",
    "        'prompt'          : prompt,\n",
    "        'generated_text'  : gen_text if verdict['status'] == 'AUTHORIZED' else '[BLOCKED BY AEGIS-∞]',\n",
    "        'raw_generated'   : gen_text,\n",
    "        'raw_confidence'  : round(confidence, 4),\n",
    "        'calibrated_conf' : round(calibrated, 4),\n",
    "        'verdict'         : verdict,\n",
    "    }\n",
    "\n",
    "\n",
    "def display_verdict(result: dict):\n",
    "    \"\"\"Pretty-print inference result.\"\"\"\n",
    "    v = result['verdict']\n",
    "    html = f\"\"\"\n",
    "    <div style=\"border:2px solid #333; border-radius:12px; padding:16px;\n",
    "                background:#0d1117; color:#e6edf3; font-family:monospace; margin:8px 0;\">\n",
    "      <div style=\"font-size:1.2em; margin-bottom:8px;\">\n",
    "        {v['icon']} <b>AEGIS-∞ VERDICT: {v['status']}</b>\n",
    "      </div>\n",
    "      <div style=\"color:#7ee787;\">Prompt: {result['prompt'][:120]}...</div>\n",
    "      <hr style=\"border-color:#333;\">\n",
    "      <div><b>Generated:</b> {result['generated_text'][:300]}</div>\n",
    "      <hr style=\"border-color:#333;\">\n",
    "      <div style=\"display:flex; gap:32px; margin-top:8px;\">\n",
    "        <span>Raw Conf: <b>{result['raw_confidence']*100:.1f}%</b></span>\n",
    "        <span>Calibrated: <b>{result['calibrated_conf']*100:.1f}%</b></span>\n",
    "        <span>Violations: <b>{list(v['violations'].keys()) or 'None'}</b></span>\n",
    "      </div>\n",
    "      <div style=\"color:#8b949e; font-size:0.85em; margin-top:6px;\">{v['message']}</div>\n",
    "    </div>\n",
    "    \"\"\"\n",
    "    display(HTML(html))\n",
    "\n",
    "print('✅ Inference wrapper ready')"
   ]
  },
